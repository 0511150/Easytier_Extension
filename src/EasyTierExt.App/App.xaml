<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyTierExt.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#141416" />
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1B1B1E" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#222226" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#2E2E35" />
      <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
