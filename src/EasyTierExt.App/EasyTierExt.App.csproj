<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>EasyTierClient</AssemblyName>
    <RootNamespace>EasyTierExt.App</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyTierExt.Contracts\EasyTierExt.Contracts.csproj" />
    <ProjectReference Include="..\EasyTierExt.HostCore\EasyTierExt.HostCore.csproj" />
  </ItemGroup>
</Project>
