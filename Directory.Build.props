<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true' and '$(TEMP)' != ''">
    <BaseIntermediateOutputPath>$(TEMP)\EasytierExtWorkBuild\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(TEMP)\EasytierExtWorkBuild\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
